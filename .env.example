# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Do NOT expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=心霊マップ

# Map tiles (default: OpenStreetMap; swap to MapTiler / Mapbox later)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Admin (used to seed the first admin's profile.role on signup if matches)
ADMIN_EMAIL=

# Salt used to hash submitter IPs server-side (any random string)
IP_HASH_SALT=change-me-to-a-random-string

# ---- Analytics / Search Console / AdSense ----
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console verification meta tag value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster verification (optional)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Google AdSense Publisher ID ("ca-pub-XXXXXXXXXXXXXXXX")
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Specific ad slot IDs (after AdSense approval, create units in AdSense and paste IDs)
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SPOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SPOT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_AREA=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY=
NEXT_PUBLIC_ADSENSE_SLOT_RANKING=

# Amazon Associates (optional). Format: "your-associate-id-22"
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# ---- Import script (scripts/import-spots.ts) ----
# true: do NOT write to DB, only log; false: actually write
DRY_RUN=true
# pending_review (recommended) or published
IMPORT_STATUS=pending_review
IMPORT_LIMIT_PER_SOURCE=30
IMPORT_TOTAL_LIMIT=300
# Nominatim geocoding (optional, future use)
ENABLE_GEOCODING=false
NOMINATIM_EMAIL=

# ---- YouTube Data API (scripts/import-youtube.ts) ----
# Get an API key from Google Cloud Console → Library → YouTube Data API v3
YOUTUBE_API_KEY=
# Settings (defaults shown)
YT_DRY_RUN=true
YT_SPOT_LIMIT=30

# ---- X (Twitter) auto-post (Vercel Cron) ----
# Get from https://developer.x.com (Free tier OK — 1500 tweets/month is plenty)
# User Auth: OAuth 1.0a → "Keys and tokens" の API Key+Secret + Access Token+Secret
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Random string. Vercel Cron will send Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
YT_RESULTS_PER_SPOT=3
